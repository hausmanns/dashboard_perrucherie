# Copy to .env and fill in your key (never commit .env).
# Required for every LLM feature:
#   - "Identifier par photo" (plants, dishes, wishes) via a vision LLM;
#   - adding a wish from a plain-French Telegram message (/envie, private chat).
# Without it those features answer 502 / say the key is missing; everything
# else (lists, watering reminders, /plantes, /envies) works fine.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional — model used for identification and for reading wish messages.
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Required for the show tracker (search, trending, covers, synopsis, episodes).
# Free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Telegram bot (optional, but recommended) ---
# Send watering reminders at 09:00 & 21:00. Create the bot with @BotFather,
# then set TELEGRAM_CHAT_ID to the chat that should receive the messages.
# See TELEGRAM_BOT.md for the full setup steps.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# IANA timezone for the reminders. Empty = server time (Docker = UTC).
# TELEGRAM_TZ=Europe/Paris

# --- Finances (FIRE tab) — reading documents with a LOCAL model ---
# Payslips, bank statements and tax bills are private: by default they are read
# by a model on this machine (any OpenAI-compatible server). With Ollama:
#   1. install Ollama, then  `ollama pull qwen2.5vl:7b`  (vision model, ~6 GB)
#   2. so that Docker can reach it, start Ollama listening on all interfaces:
#      Windows: setx OLLAMA_HOST 0.0.0.0  (then restart Ollama)
# Empty = Ollama on the host (http://host.docker.internal:11434/v1 in Docker).
# LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_LLM_MODEL=qwen2.5vl:7b
# LOCAL_LLM_API_KEY=
# local_first (default: local, then OpenRouter if allowed) | local_only | cloud_only
# LLM_MODE=local_first
