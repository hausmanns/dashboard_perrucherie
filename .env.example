# Copy to .env and fill in your key (never commit .env).
# Required for "Identifier par photo" (plant recognition via a vision LLM).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional — vision model used for plant identification.
# OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Telegram bot (optional, but recommended) ---
# Send watering reminders at 09:00 & 21:00. Create the bot with @BotFather,
# then set TELEGRAM_CHAT_ID to the chat that should receive the messages.
# See TELEGRAM_BOT.md for the full setup steps.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# IANA timezone for the reminders. Empty = server time (Docker = UTC).
# TELEGRAM_TZ=Europe/Paris
